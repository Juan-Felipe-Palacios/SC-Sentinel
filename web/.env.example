DATABASE_URL=
ADMIN_SECRET=
SC_SESSION_SECRET=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (spec §11): solo Preview/Producción; nunca commitear un valor real.
#
# AI_PROVIDER define el proveedor PRIMARIO (openrouter | gemini | groq). La
# cadena de respaldo agrega automáticamente el resto de proveedores que tengan
# key: gemini → openrouter → groq. Si un proveedor responde 429 entra en
# cooldown y se salta al siguiente, así que conviene cargar LAS TRES keys en
# cada entorno para que la cuota free rinda.
# AI_PROVIDER=gemini

# OpenRouter (router de modelos gratuitos `:free`).
OPENROUTER_API_KEY=

# Google AI Studio (SDK @google/genai): https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (SDK groq-sdk): https://console.groq.com/keys
# GROQ_API_KEY=

# Modelos separados por comas; aplica SOLO al proveedor primario (los
# respaldos usan sus defaults). Si falta: openrouter/free |
# gemini-3.8-flash | openai/gpt-oss-120b,openai/gpt-oss-20b.
# AI_MODELS=


# Device unico de v1 (ADR-0007). Si falta, se resuelve el primer device enrolado.
# DEFAULT_DEVICE_ID=

# Token de desarrollo para /api/ingest local (nunca en Preview/Produccion).
# SC_INGEST_DEV_TOKEN=

# Demo pública de solo lectura. Opcional: si falta, usa DEFAULT_DEVICE_ID o el primer device.
# Si se define, solo ese device queda expuesto a la demo pública.
# SC_GUEST_DEVICE_ID=
