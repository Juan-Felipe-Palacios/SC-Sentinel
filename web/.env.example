DATABASE_URL=
ADMIN_SECRET=
SC_SESSION_SECRET=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (spec §11): solo Preview/Producción; nunca commitear un valor real.
# Proveedor: openrouter | gemini | groq. Si falta, se detecta por la key presente.
# AI_PROVIDER=gemini

# OpenRouter (router de modelos gratuitos).
OPENROUTER_API_KEY=

# Google AI Studio (SDK @google/genai): https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (SDK groq-sdk): https://console.groq.com/keys
# GROQ_API_KEY=

# Modelos separados por comas; si falta, se usan los defaults del proveedor
# (openrouter/free | gemini-3.8-flash | openai/gpt-oss-120b,openai/gpt-oss-20b).
# AI_MODELS=


# Device unico de v1 (ADR-0007). Si falta, se resuelve el primer device enrolado.
# DEFAULT_DEVICE_ID=

# Token de desarrollo para /api/ingest local (nunca en Preview/Produccion).
# SC_INGEST_DEV_TOKEN=
