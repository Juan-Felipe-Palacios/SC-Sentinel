        <mxCell id="aggregate" value="FlowUpdate -> sc-aggregate&#10;(mismo pipeline que pcap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="/api/ingest&#10;(Ventana y snapshot identicos a M1/M2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="700" y="390" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Diferencias pcap vs flow (documentar en M4):&#10;- flows no son packets: sin bytes por paquete ni MAC&#10;- sampling del router puede omitir flujos&#10;- activo/inactivo timeout afecta granularity&#10;- medidas configuracion export MikroTik (activo timeout corto)" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="360" height="120" as="geometry" />
