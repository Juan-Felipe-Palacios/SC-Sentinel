        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="collector" target="aggregate" ><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="aggregate" target="cloud" ><mxGeometry relative="1" as="geometry" /></mxCell>
