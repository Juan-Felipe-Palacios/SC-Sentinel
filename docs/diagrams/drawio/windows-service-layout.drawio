<mxfile host="app.diagrams.net" version="24.7.7">
  <diagram id="windows-service-layout" name="Layout servicio Windows (M5)">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="scm" value="Windows Service Control Manager&#10;sc.exe create &quot;SC-Sentinel-Agent&quot;&#10;binPath= &quot;\&quot;C:\...\sc-sentinel-agent.exe\&quot; --config &quot;C:\...\config.toml\&quot;&quot;&#10;start= auto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="progfiles" value="C:\Program Files\SC-Sentinel\&#10;- sc-sentinel-agent.exe (binario)&#10;- config.example.toml (referencia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="programdata" value="C:\ProgramData\SC-Sentinel\&#10;- config.toml (permisos restrictivos)&#10;- spool.sqlite (cota 500 MB / 7 d FIFO)&#10;- logs\ (sin tokens ni payloads; spec 9.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="env" value="SC_SENTINEL_TOKEN (env del servicio)&#10;token plano nunca en config.toml en prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="desinstalar" value="Desinstalacion limpia (runbook):&#10;sc.exe stop -> sc.exe delete&#10;Remove-Item Program Files + ProgramData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="npcap" value="Prerrequisito: Npcap instalado&#10;(NO se redistribuye; se pide al usuario)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="binPath" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="scm" target="progfiles" ><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="--config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="scm" target="programdata" ><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="lee al iniciar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="env" target="scm" ><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="requerido por sc-capture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="npcap" target="progfiles" ><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
