# Configuración del agente SCNet.
# Copiar a config.toml y pasar la ruta con `sc-sentinel-agent --config <ruta>`.
# Los overrides de entorno pisan estos valores: SC_INGEST_URL, SC_SPOOL_PATH,
# SC_SPOOL_MAX_BYTES, SC_LOG, SC_ANONYMIZE_HOSTS, SC_COLLECTOR_ENABLED y
# SC_COLLECTOR_PORTS. Los flags de CLI (--collector/--no-collector y
# --collector-port) tienen la última palabra.

[ingest]
url = "https://sc-sentinel.vercel.app/api/ingest"
token_env = "SC_INGEST_TOKEN"  # Bearer según contrato §1; nunca escribir el token acá
compression = "gzip"           # único valor implementado por el cliente

[privacy]
# false (por defecto): el snapshot incluye la IP del host y el dashboard muestra
# IP + nombre resuelto. true: la IP nunca sale del equipo (ip_display = null) y
# los destinos se ven como host anonimizado.
anonymize_hosts = false
# Clave HMAC de host_mark. Prioridad: SC_HMAC_KEY → hmac_key_file → clave nueva
# generada y persistida en el primer arranque. No versionar el .host-key: si
# cambia la clave, los host_key del dashboard dejan de coincidir con el historial.
hmac_key_env = "SC_HMAC_KEY"
hmac_key_file = "./config/.host-key"

[spool]
path = "./spool/sc-spool.sqlite"
max_bytes = 524288000
max_age_days = 7

[log]
level = "info"                 # SC_LOG tiene prioridad
# Archivo de log del servicio (tracing-appender never-rotate). Sin `file` el
# agente loguea a stdout (modo CLI interactivo); como servicio sin esta key se
# usa C:\ProgramData\SC-Sentinel\logs\agent.log.
# file = "C:/ProgramData/SC-Sentinel/logs/agent.log"

[detection]
# Motor determinista local: blacklist, escaneos salientes/entrantes, DNS,
# volumen y salud. Se ejecuta siempre que la captura esté activa.
enabled = true
# Una IP exacta (IPv4 o IPv6) por línea; `#` inicia un comentario.
# Si se configura y el archivo no existe, el agente no arranca.
# blacklist_file = "./blacklist.txt"

# Escaneo saliente: el extremo local toca muchos puertos remotos distintos.
port_scan_min_ports = 20
port_scan_min_connections = 20
port_scan_max_connections_per_port = 3

# Escaneo entrante: un peer remoto toca muchos puertos locales distintos.
inbound_scan_enabled = true
inbound_scan_min_ports = 20
inbound_scan_min_connections = 20
inbound_scan_max_connections_per_port = 3

# Túnel DNS: consultas, bytes totales y tamaño medio por consulta.
dns_min_queries = 100
dns_min_bytes = 65536
dns_min_avg_bytes = 100

# Volumen por peer remoto en la ventana de 30 s.
volume_min_bytes = 104857600

# Salud operativa: drops y errores de parseo.
drop_ratio_percent = 5.0
min_drops = 100
min_parse_errors = 10

[collector]
# Colector pasivo UDP: recibe NetFlow v5/v9 e IPFIX de routers y switches y
# los entrega al mismo aggregator que la captura local. false = solo pcap.
enabled = true
# 0.0.0.0 acepta exportadores de toda la red; 127.0.0.1 solo los locales.
bind_addr = "0.0.0.0"
# "auto" detecta la versión por datagrama; "v5", "v9" o "ipfix" la fijan.
listeners = [
    { port = 2055, protocol = "auto" },
    { port = 4739, protocol = "auto" },
    { port = 9995, protocol = "auto" },
    { port = 9996, protocol = "auto" },
]
# Cache LRU de templates por socket (cada listener tiene la suya).
template_cache_capacity = 10000
template_cache_ttl_secs = 3600
